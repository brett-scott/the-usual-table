# Public frontend configuration only. Point this at the deployed Worker for Pages.
VITE_API_BASE_URL=http://127.0.0.1:8787
# GitHub Pages project example: /repository-name/
VITE_BASE_PATH=/
# Optional paired overrides. The checked-in public configuration already selects The Usual Table project.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
# Saved wallet SQL setup: WALLET_SETUP.md. The default project needs no new keys.
# Custom Worker projects use matching SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY
# in apps/server/.dev.vars locally, or production environment variables for deploys.
# Deployment workflows use repository/environment variables documented in
# DEPLOYMENT.md. Keep Cloudflare API tokens in GitHub secrets only.
